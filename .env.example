# Example only. Never commit real secrets.
TICKMEET_DB_URL=jdbc:mysql://127.0.0.1:3306/tickmeet?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
TICKMEET_DB_USER=tickmeet
TICKMEET_DB_PASSWORD=replace-me
TICKMEET_MQ_USER=replace-me
TICKMEET_MQ_PASSWORD=replace-me
TICKMEET_CALLBACK_SECRET=replace-with-at-least-32-random-characters
TICKMEET_DEMO=false
TICKMEET_SEED=false
# Enable mail profile for real email: SPRING_PROFILES_INCLUDE=mail
TICKMEET_SMTP_HOST=smtp.example.com
TICKMEET_SMTP_PORT=587
TICKMEET_SMTP_USER=replace-me
TICKMEET_SMTP_PASSWORD=replace-me
TICKMEET_MAIL_FROM=replace-me@example.com
# Optional s3 profile; existing local files require explicit migration.
TICKMEET_S3_ENDPOINT=http://127.0.0.1:9000
TICKMEET_S3_ACCESS_KEY=replace-me
TICKMEET_S3_SECRET_KEY=replace-me
TICKMEET_S3_BUCKET=tickmeet-images
